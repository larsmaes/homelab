machine:
  registries:
    config:
      ghcr.io:
        auth: 
          auth: ${ghrc_registry_auth}
cluster:
  extraManifests:
    - https://raw.githubusercontent.com/alex1989hu/kubelet-serving-cert-approver/main/deploy/standalone-install.yaml
  inlineManifests:
    - name: fluxcd-namespace
      contents: |-
        apiVersion: v1
        kind: Namespace
        metadata:
          name: flux-system
    - name: fluxcd
      contents: |-
        ${indent(8,fluxcd_manifest)}
    - name: fluxcd-repo-secret
      contents: |-
        ${indent(8,fluxcd_repo_secret)}
    - name: fluxcd-repo
      contents: |-
        ${indent(8,fluxcd_repo)}
    - name: fluxcd-sync
      contents: |-
        ${indent(8,fluxcd_sync)}
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: ${hostname} 
auto: off
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/nocloud-installer-secureboot/${talos_image_id}:${talos_version}
provisioning:
  diskSelector:
    match: disk.dev_path == "${install_disk}"
  wipe: false
---
apiVersion: v1alpha1
kind: KubeletConfig
extraArgs:
  rotate-server-certificates: "true"
    